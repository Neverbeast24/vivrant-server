# Supabase — server-only (no NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://gcqbuccazplfpmuhperg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_JWKS_URL=https://gcqbuccazplfpmuhperg.supabase.co/auth/v1/.well-known/jwks.json

# Firebase Web app configuration (from Firebase Console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=viva-6a54d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=viva-6a54d
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=viva-6a54d.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=341841301775
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-4PJFPXN5B8
# Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (server-only) — Project Settings → Service accounts → Generate new private key
# Paste the entire JSON as a single line (escape newlines in private_key as \n)
FIREBASE_SERVICE_ACCOUNT_JSON=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free Gmail SMTP (preferred) — inquiry auto-replies + admin quotes
# Google Account → Security → App passwords (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=
EMAIL_FROM="VIVRΛNT <your@gmail.com>"

# Optional Resend fallback (limited without a verified domain)
# RESEND_API_KEY=

# Gemini Developer API (server-only — never commit real keys)
GEMINI_API_KEY=
# Prefer a stable model id — avoid gemini-flash-latest during peak demand
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=

# Vercel Cron (server-only) — shared secret for /api/cron/reminders.
# Required: the endpoint returns 503 when this is missing.
CRON_SECRET=
